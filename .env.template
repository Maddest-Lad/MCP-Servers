# Copy to .env (same folder) and fill in. .env is gitignored.

# ---------- plexamp server (src/plexamp) ----------

# PMS base URL. Use a LAN address, not 127.0.0.1: players are told to
# connect back to this address when you start playback on them.
PLEX_URL=http://0.0.0.0:32400

# Plex account token (sent only as the X-Plex-Token header).
# How to find it: https://support.plex.tv/articles/204059436
PLEX_TOKEN=

# Optional: stable X-Plex-Client-Identifier. Defaults to a UUID derived
# from this machine's hostname.
PLEX_CLIENT_ID=

# Optional: comma-separated music section ids to allow (default: all music libraries).
PLEX_MUSIC_SECTIONS=

# Optional: comma-separated host[:port] of Plexamp Headless players that PMS
# doesn't list in /clients (port defaults to 32500).
PLEXAMP_PLAYERS=

# Optional: PMS request timeout in seconds.
PLEX_TIMEOUT=15
