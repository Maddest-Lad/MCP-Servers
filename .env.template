# plexamp: all optional. Sign in via /mcp -> plexamp -> Authenticate.

# Server name, if your account sees several
PLEX_SERVER=
# Sign-in store (default ~/.plexamp-mcp/auth.json)
PLEX_AUTH_FILE=

# MCP endpoint: http://PLEXAMP_HOST:PLEXAMP_PORT/mcp
PLEXAMP_HOST=127.0.0.1
PLEXAMP_PORT=8765
# http (with sign-in) or stdio (needs PLEX_URL + PLEX_TOKEN)
PLEXAMP_TRANSPORT=http

# Skip sign-in/discovery. PLEX_URL must be a LAN address
PLEX_URL=
PLEX_TOKEN=

# Comma-separated music section ids to allow
PLEX_MUSIC_SECTIONS=
# Comma-separated host[:port] of headless players (port 32500)
PLEXAMP_PLAYERS=
# Default: derived from hostname
PLEX_CLIENT_ID=
# Seconds
PLEX_TIMEOUT=15
